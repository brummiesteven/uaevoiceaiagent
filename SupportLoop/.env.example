# Copy to .env.local and fill.
#
# Supabase and Linear degrade gracefully when missing: a report is still stored and still
# shows on /triage, with a readable warning. SUPPORT_AGENT_SECRET does not degrade — the
# agent ticket endpoint refuses to run without it in production, because an open endpoint
# there means anyone can flood the team's Linear board.

# Supabase — call_feedback and tickets (supabase/schema.sql)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Linear — the ticket a report becomes, assigned to Devin
# Key: Linear -> Settings -> Security & access -> Personal API keys
LINEAR_API_KEY=
# Team UUID, not the short key. Query it: { teams { nodes { id key name } } }
LINEAR_TEAM_ID=
# Optional: skip looking up the Devin user by name
LINEAR_DEVIN_USER_ID=

# Shared secret the agent sends as the x-support-secret header when filing a ticket.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SUPPORT_AGENT_SECRET=

# ElevenLabs post-call webhook, which attaches the transcript to the report.
# Created when you add the post_call_transcription webhook in the ElevenLabs dashboard.
ELEVENLABS_WEBHOOK_SECRET=

# Used in Linear issue bodies to link back to /triage
NEXT_PUBLIC_APP_URL=
