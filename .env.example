# Copy to .env.local and fill. Every key is optional at boot: a missing one degrades
# one feature with a readable message instead of failing the deployment.

# Context.dev — crawl + structured extraction (npm run scrape)
CONTEXT_DEV_API_KEY=

# ElevenLabs — the agent, the knowledge base sync, and the adversarial suite
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Shown by the browser widget, so it is public by design
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
# Created when you add the post_call_transcription webhook
ELEVENLABS_WEBHOOK_SECRET=
# Optional: voice used to render the audio personas
ELEVENLABS_CALLER_VOICE_ID=

# Supabase — call_feedback and tickets (supabase/schema.sql)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Linear — the ticket the repair loop opens, assigned to Devin
LINEAR_API_KEY=
LINEAR_TEAM_ID=
# Optional: skip the lookup of the Devin user by name
LINEAR_DEVIN_USER_ID=

# Used in Linear issue bodies to link back to /triage
NEXT_PUBLIC_APP_URL=
